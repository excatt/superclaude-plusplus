{
  "permissions": {
    "allow": [
      "Skill(*)",
      "mcp__pencil"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-compact-note.sh",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/skill-matcher.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/type-check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/console-log-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/auto-format.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/convention-check.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/injection-scanner.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/todo-continuation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/scripts/evaluate-session.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/session-summary.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/circuit-breaker.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/suggest-compact.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Task가 완료되었습니다. Two-Stage Review를 실행하세요: Stage 1(Spec Compliance) → Stage 2(Code Quality). RULES.md의 Two-Stage Review System 절차를 따르세요."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '📋 서브에이전트 완료. 결과를 검증하세요.'",
            "timeout": 1
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".env*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ .env 파일 변경 감지. git에 커밋되지 않도록 .gitignore를 확인하세요.'",
            "timeout": 1
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '🔧 설정 변경 감지. 유효성을 확인하세요.'",
            "timeout": 1
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'SuperClaude++ v3.3 loaded'",
            "timeout": 1
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh",
    "padding": 0
  },
  "language": "한국어",
  "outputStyle": "fluent-korean",
  "alwaysThinkingEnabled": true,
  "extraKnownMarketplaces": {
    "fluent-korean": {
      "source": {
        "source": "github",
        "repo": "snflkd/fluent-korean"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "fluent-korean@fluent-korean": true,
    "security-guidance@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
